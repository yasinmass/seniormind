# Environment variables for the SeniorMind backend.
# Copy this file to .env and fill in any values you need to override.
# DO NOT commit .env to version control.

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Set to "ollama" for local development (free, no API key needed).
# Set to "openai" to switch to cloud OpenAI (requires LLM_API_KEY below).
LLM_PROVIDER=ollama

# ── Model name ────────────────────────────────────────────────────────────────
# For Ollama: any model you have pulled, e.g. llama3.2:3b, mistral, phi3
# For OpenAI: gpt-4o-mini, gpt-4o, etc.
LLM_MODEL=llama3.2:3b

# ── Ollama settings (only used when LLM_PROVIDER=ollama) ─────────────────────
# URL where Ollama is running. Default: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# ── OpenAI settings (only used when LLM_PROVIDER=openai) ─────────────────────
# Your OpenAI API key — required only when switching to cloud OpenAI.
# Get yours at: https://platform.openai.com/api-keys
LLM_API_KEY=

# ── General ───────────────────────────────────────────────────────────────────
# Timeout in seconds for LLM API calls
LLM_TIMEOUT_SECONDS=60
